MLIR_SYS_230_PREFIX=/usr/lib/llvm-23
TABLEGEN_230_PREFIX=/usr/lib/llvm-23
RUSTFLAGS=-L /usr/lib/llvm-23/lib
LLZK_SYS_ENABLE_WHOLE_ARCHIVE=1
LLVM_DIR=/usr/lib/llvm-23/lib/cmake/llvm
MLIR_DIR=/usr/lib/llvm-23/lib/cmake/mlir
Clang_DIR=/usr/lib/llvm-23/lib/cmake/clang
LLVM_BIN=/usr/lib/llvm-23/bin/
ASAN_SYMBOLIZER_PATH=/usr/lib/llvm-23/bin/llvm-symbolizer
CC=/usr/lib/llvm-23/bin/clang
CXX=/usr/lib/llvm-23/bin/clang++
